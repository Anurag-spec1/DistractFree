<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    app:carbon_cornerRadiusBottomEnd="40dp"
    app:carbon_cornerRadiusBottomStart="40dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    tools:context=".activity.Welcome">

    <carbon.widget.LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center">



        <carbon.widget.TextView
            android:id="@+id/headTxt1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/main_font_2"
            android:text="WHAT IS"
            android:textColor="@color/black"
            android:textSize="34sp" />

        <carbon.widget.TextView
            android:id="@+id/headPTxt2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/main_font_2"
            android:text="DistractFree?"
            android:textColor="@color/colorAccentLight"
            android:textSize="34sp"
            android:textStyle="bold" />

    </carbon.widget.LinearLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:padding="0dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/f1" />

    <carbon.widget.TextView
        android:id="@+id/descriptionTxt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/main_font"
        android:gravity="center"
        android:text="KIET E-Cell is a student body of KIET, formed in 2014 with the aim to promote an entrepreneurial culture among the young minds of today's generation."
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/nextBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</carbon.widget.LinearLayout>